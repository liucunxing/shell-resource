# Public iframe URL only. Never put secrets or authentication tokens here.
VITE_YIWEN_IFRAME_URL=https://dataaitest.digitalshell.com.cn/

# Default is API mode. Demo data is only enabled by setting VITE_DATA_MODE=demo.
VITE_API_BASE_URL=/api/v1/workbench
VITE_PLANNING_YEAR=2027
# UAT login input: true permits manual email entry; false keeps Portal email read-only.
# Build-time flag. Rebuild the frontend after changing this value.
VITE_LOGIN_EMAIL_EDITABLE=true
