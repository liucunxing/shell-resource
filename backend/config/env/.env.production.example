# Copy to config/env/.env.production only when file-based production configuration
# is required. Prefer deployment-platform environment variables for secrets.
APP_NAME=Shell Forecast Backend
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false
DOCS_ENABLED=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
DB_ECHO=false
CORS_ORIGINS=["https://frontend.example.com"]
SSO_ENABLED=true
SSO_ISSUER=https://sso.example.com
SSO_CLIENT_ID=replace-me
SSO_CLIENT_SECRET=replace-me

