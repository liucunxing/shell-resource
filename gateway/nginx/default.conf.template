# Preserve the existing application's upload and long-running request limits.
client_max_body_size 20m;
proxy_read_timeout 300s;
proxy_send_timeout 300s;
ssl_protocols TLSv1.2 TLSv1.3;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name resource.digitalshell.com.cn oneportal.digitalshell.com.cn;
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "gateway healthy\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/private.key;
    return 444;
}

server {
    listen 443 ssl;
    server_name resource.digitalshell.com.cn;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/private.key;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "gateway healthy\n";
    }
    location / {
        proxy_pass ${RESOURCE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name oneportal.digitalshell.com.cn;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/private.key;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "gateway healthy\n";
    }
    location / {
        proxy_pass ${ONEPORTAL_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
