# This directory is deployed once to /opt/digitalshell-gateway on the ECS.
COMPOSE_PROJECT_NAME=digitalshell-gateway
GATEWAY_NGINX_IMAGE=digitalshell-gateway:1.30.6-brotli1.2.1
GATEWAY_CERTS_DIR=./certs

# Only loopback upstreams are permitted. Each application owns a distinct port.
RESOURCE_UPSTREAM=http://127.0.0.1:18080
ONEPORTAL_UPSTREAM=http://127.0.0.1:18081
