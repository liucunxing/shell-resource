# Rendered by the official image entrypoint, with HTTPS_DOMAIN only.
server {
    listen 80;
    server_name ${HTTPS_DOMAIN};

    # Container liveness only. End-to-end readiness is checked via HTTPS /health.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${HTTPS_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${HTTPS_DOMAIN};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;

    # Resolve through Docker DNS at request time, so app container recreation
    # does not leave Nginx forwarding to an obsolete container IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $app_backend http://app:8000;

    location / {
        proxy_pass $app_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
