# Copy this file to deploy/.env on the server. It contains no application secrets.
COMPOSE_PROJECT_NAME=shell-forecast
IMAGE_TAG=replace-with-release-commit

# Use development only for the current internal UAT identity flow.
# Do not switch to production until trusted SSO has been implemented and verified.
APP_ENV=development
APP_SETTINGS_SOURCE=./deploy/settings.toml

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=80
WEB_CONCURRENCY=2
TZ=Asia/Shanghai

# Set these to the numeric uid/gid that owns deploy/settings.toml on Linux.
APP_UID=1000
APP_GID=1000

# These values are compiled into the frontend image at build time.
VITE_API_BASE_URL=/api/v1/workbench
VITE_PLANNING_YEAR=2027
VITE_YIWEN_IFRAME_URL=https://dataaitest.digitalshell.com.cn/

# Optional Docker Nginx HTTPS. deploy/https.sh enables this profile and sets
# APP_BIND_ADDRESS=127.0.0.1 to close direct public HTTP access to the app.
# COMPOSE_PROFILES=https
HTTPS_DOMAIN=resource.digitalshell.com.cn
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_BIND_ADDRESS=0.0.0.0
NGINX_IMAGE=nginx:1.30.5-alpine
